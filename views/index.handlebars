<form action="/" method="post">
    <p>chatbox</p>
    <input name="prompt" placeholder="Enter your prompt" style="margin-bottom: 10px;">
    <button style="font-weight:bold" type="submit">Confirm</button>
</form>

{{#if answer}}
<div style="margin-top: 20px; padding: 10px; border: 1px solid #ccc;">
    <p><strong>repsond</strong></p>
    <p>{{answer}}</p>
</div>
{{/if}}